<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StockfishSharpUci</AssemblyName>
    <RootNamespace>StockfishSharp.Uci</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StockfishSharp.Engine\StockfishSharp.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Libro di aperture Polyglot (D1) — file di terze parti, gitignored (vedi .gitignore). -->
    <None Update="Assets\Book\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
